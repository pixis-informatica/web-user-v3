# ── Base de datos ──
DATABASE_URL="file:./dev.db"

# ── JWT Secret (cambiar en producción) ──
JWT_SECRET="cambiar-este-secreto-en-produccion"

# ── Gmail SMTP (usar "Contraseña de aplicación" de Google) ──
# Instrucciones: https://support.google.com/accounts/answer/185833
GMAIL_USER="tu-email@gmail.com"
GMAIL_APP_PASSWORD="xxxx xxxx xxxx xxxx"

# ── Entorno y Cookies ──
NODE_ENV="development"
# COOKIE_DOMAIN: Dominio raíz sin www para habilitar la validez de cookies en subdominios (ej. pixistech.com).
# Dejar vacío en desarrollo local para evitar problemas con localhost.
COOKIE_DOMAIN=""
